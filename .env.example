# Palavra de verificação exigida no login (junto com um CIM autorizado).
# Trocar a palavra derruba todas as sessões abertas.
PALAVRA_VERIFICACAO=

# --- Armazenamento -----------------------------------------------------------
# Padrão: arquivo JSON local. Precisa de disco persistente no servidor.
# DATA_FILE=.data/agenda.json

# Opcional, para hospedagem sem disco persistente (ex.: Vercel): grava o JSON
# num repositório GitHub PRIVADO. Se as duas variáveis abaixo estiverem
# preenchidas, o arquivo local deixa de ser usado.
# Token: fine-grained, só esse repositório, permissão "Contents: Read and write".
# GITHUB_TOKEN=
# GITHUB_REPO=dono/repositorio-privado
# GITHUB_BRANCH=main
# GITHUB_PATH=agenda.json
