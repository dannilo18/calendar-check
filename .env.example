# Palavra de verificação exigida no login (junto com um CIM autorizado).
# Trocar a palavra derruba todas as sessões abertas.
PALAVRA_VERIFICACAO=

# --- Armazenamento -----------------------------------------------------------
# Padrão: arquivo JSON local. Precisa de disco persistente no servidor.
# DATA_FILE=.data/agenda.json
# FILES_DIR=.data/documentos

# Opcional, para hospedagem sem disco persistente (ex.: Vercel): grava o JSON
# num repositório GitHub PRIVADO. Se as duas variáveis abaixo estiverem
# preenchidas, o arquivo local deixa de ser usado.
# Token: fine-grained, só esse repositório, permissão "Contents: Read and write".
# GITHUB_TOKEN=
# GITHUB_REPO=dono/repositorio-privado
# GITHUB_BRANCH=main
# GITHUB_PATH=agenda.json
# Pasta do acervo (decisões, PDFs, identidade visual) dentro do repositório.
# GITHUB_FILES_PATH=documentos

# --- Notificações por e-mail ---------------------------------------------------
# Evento novo, documento novo e imagem nova geram um e-mail para todos os
# membros com e-mail cadastrado (menos o autor). Sem as duas variáveis do
# Gmail, nada é enviado.
# GMAIL_USER: conta Gmail da chapa. GMAIL_APP_PASSWORD: "senha de app" gerada
# em myaccount.google.com/apppasswords (exige verificação em duas etapas).
# GMAIL_USER=
# GMAIL_APP_PASSWORD=
# Os e-mails dos membros NÃO ficam aqui: ficam em membros.json no
# repositório privado de dados (ou em .data/ localmente). Ver README.
# Endereço público do site, usado nos links dos e-mails (opcional; sem ele,
# usa o endereço de quem fez a alteração).
# SITE_URL=https://agenda.exemplo.com
# Lembrete da véspera (cron da Vercel, vercel.json): todo dia às 15h quem
# confirmou presença num evento de amanhã recebe um e-mail. A Vercel manda
# este segredo no cabeçalho Authorization; sem ele a rota /api/lembretes fica
# fechada. Gere com: openssl rand -hex 32
# CRON_SECRET=
# Opcional: outro servidor SMTP no lugar do Gmail (remetente = EMAIL_FROM).
# SMTP_URL=smtps://usuario:senha@smtp.dominio.com.br:465
# EMAIL_FROM=
